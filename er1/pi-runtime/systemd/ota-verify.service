[Unit]
Description=OTA verification watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rudyy
Group=rudyy
WorkingDirectory=/home/rudyy/er1
Environment=LOCAL_BROKER=127.0.0.1
ExecStart=/home/rudyy/er1/scripts/ota_verify daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
