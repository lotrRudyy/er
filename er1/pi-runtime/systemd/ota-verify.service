[Unit]
Description=OTA verification watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rudyy
Group=rudyy
WorkingDirectory=/home/rudyy/er1
Environment=LOCAL_BROKER=127.0.0.1
ExecStartPre=/usr/bin/mkdir -p /home/rudyy/er1/node_firmware
ExecStart=/usr/bin/python3 /home/rudyy/er1/node_firmware/ota_verify.py daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
