# Pi dashboard
ER1_MQTT_HOST=192.168.0.10
ER1_MQTT_PORT=1883
ER1_DASHBOARD_CLIENT_ID=er1_dashboard

# Website API used for booking selection and summary emails.
# Use the Debian server URL from the Pi, for example http://192.168.0.20:3002
# or https://escapeschenna.com when the Pi can reach the public domain.
ER1_WEBSITE_API_BASE=http://192.168.0.10:3002

# Optional shared token. Must match GAME_SUMMARY_API_TOKEN on the website if set there.
ER1_WEBSITE_API_TOKEN=

# Optional override for the game master SQLite database.
# ER1_GAME_DB_PATH=/home/pi/scripts/game_master/data/game_master.sqlite3
