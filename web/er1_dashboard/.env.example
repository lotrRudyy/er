# Pi dashboard
ER1_MQTT_HOST=192.168.0.10
ER1_MQTT_PORT=1883
ER1_DASHBOARD_CLIENT_ID=er1_dashboard

# Game master SQLite database on the Pi, only needed for the completed-game editor.
# ER1_GAME_DB_PATH=/home/rudyy/er1/scripts/game_master/data/game_master.sqlite3

# Booking database sync: the Pi dashboard SSHes into the Debian website server,
# creates a consistent SQLite backup there, scps it to the Pi, then reads bookings locally.
ER1_BOOKINGS_SOURCE=ssh-copy
ER1_WEBSITE_SSH_HOST=192.168.0.111
ER1_WEBSITE_SSH_USER=rudyy
ER1_WEBSITE_SSH_PORT=22
ER1_WEBSITE_DB_PATH=/home/rudyy/escapeschenna/data/app.db
ER1_LOCAL_BOOKINGS_DB_PATH=/home/rudyy/er1/web/data/website_app_bookings.sqlite3
ER1_WEBSITE_SSH_TIMEOUT=10

# Summary email: default is SSH. The Pi copies the game payload to the Debian website
# server and runs the website's email script there, so SMTP config stays on the website.
ER1_SUMMARY_EMAIL_MODE=ssh
ER1_WEBSITE_APP_PATH=/home/rudyy/escapeschenna
ER1_WEBSITE_SUMMARY_SCRIPT=scripts/send-game-summary-email.js

# Optional legacy HTTP mode only. Leave empty when using SSH mode.
ER1_WEBSITE_API_BASE=
ER1_WEBSITE_API_TOKEN=
