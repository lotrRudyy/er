#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/er1"
SCRIPTS="$ROOT/scripts"

CMD="${1:-}"; shift || true

case "$CMD" in
  logs)
    SUB="${1:-}"; shift || true
    case "$SUB" in
      live)  "$SCRIPTS/mqtt-logs.sh" live ;;
      tail)  "$SCRIPTS/mqtt-logs.sh" tail ;;
      grep)  "$SCRIPTS/mqtt-logs.sh" grep "$@" ;;
      help|"") "$SCRIPTS/mqtt-logs.sh" help ;;
      *)
        echo "Usage: er1 logs {live|tail|grep <pattern>|help}" >&2
        exit 1
        ;;
    esac
    ;;

  lock)
    ACTION="${1:-}"; ID="${2:-}"
    case "$ACTION" in
      open|close)
        if [ -z "$ID" ]; then
          echo "Usage: er1 lock {open|close} <lock_id>" >&2
          exit 1
        fi
        "$SCRIPTS/mqtt-locks.sh" "$ACTION" "$ID"
        ;;
      open_all)
        "$SCRIPTS/mqtt-locks.sh" open images
        "$SCRIPTS/mqtt-locks.sh" open slider
        "$SCRIPTS/mqtt-locks.sh" open knocking
        "$SCRIPTS/mqtt-locks.sh" open r2
        "$SCRIPTS/mqtt-locks.sh" open r3
        ;;
      close_all)
        "$SCRIPTS/mqtt-locks.sh" close images
        "$SCRIPTS/mqtt-locks.sh" close slider
        "$SCRIPTS/mqtt-locks.sh" close knocking
        "$SCRIPTS/mqtt-locks.sh" close r2
        "$SCRIPTS/mqtt-locks.sh" close r3
        ;;
      ""|help)
        echo "Usage: er1 lock {open|close <id>|open_all|close_all}" >&2
        exit 1
        ;;
      *)
        echo "Unknown lock action '$ACTION'" >&2
        exit 1
        ;;
    esac
    ;;

  syslog)
    if [ -x "$SCRIPTS/syslog_tail" ]; then
      "$SCRIPTS/syslog_tail"
    else
      echo "No syslog helper wired." >&2
    fi
    ;;

  ""|help|-h|--help)
    cat <<USAGE
er1 – ER1 helper CLI

Usage:
  er1 logs live                 # live MQTT view
  er1 logs tail                 # tail today's log
  er1 logs grep <pattern>       # grep in today's log
  er1 lock open <id>            # open lock
  er1 lock close <id>           # close lock
  er1 lock open_all             # open all locks
  er1 lock close_all            # close all locks
  er1 syslog                    # system log (if wired)
USAGE
    ;;

  *)
    echo "Unknown command '$CMD'. Try: er1 help" >&2
    exit 1
    ;;
esac
