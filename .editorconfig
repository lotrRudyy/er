root = true

# ER1 uses 2-space indentation across firmware + docs.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{json,jsonc,code-workspace}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = true
