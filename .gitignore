# ---- IDE / OS clutter ----
.DS_Store
__pycache__/
*.code-workspace
*.zip

# VS Code (keep only settings.json tracked)
.vscode/.browse.VC.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
!.vscode/settings.json

# ---- PlatformIO build output ----
# Old flat .pio plus per-ER firmware output
.pio/
er1/firmware/.pio/

# ---- Pi runtime: logs and local secrets stay on the Pi ----
er1/pi-runtime/logs/
er1/pi-runtime/config/local.env

# --- Tools: commit code, ignore outputs ---
er1/tools/out/
er1/tools/**/*.csv
er1/tools/**/*.png
er1/tools/**/*.log


# Skeleton placeholders for future rooms
# (ignore their runtime logs/config if created)
er2/pi-runtime/logs/
er2/pi-runtime/config/local.env
er3/pi-runtime/logs/
er3/pi-runtime/config/local.env

# ---- Data runtime logs & temporary dumps ----
er1/data/logs/**
er1/data/*.log
er1/data/*.log.*
er1/data/**/*.log
er1/data/**/*.log.*

# ---- Local helper scripts not tracked in repo ----
deploy.sh
er1/firmware/.vscode/launch.json
er1/firmware/.vscode/c_cpp_properties.json
er1/firmware/.vscode/c_cpp_properties.json
er1/firmware/.vscode/launch.json

# Global outputs
out/

# Logs
*.log
er1/firmware/.vscode/c_cpp_properties.json
er1/firmware/.vscode/launch.json
